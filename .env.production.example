# Template untuk menu "Environment Variables" di Coolify.
# Jangan commit nilai sebenar ke GitHub.

APP_NAME=BBCashvia
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-coolify-anda.example
APP_PORT=8000

# Jana dengan: php artisan key:generate --show
# Boleh dikosongkan: entrypoint akan jana APP_KEY sekali dan simpan dalam volume storage.
APP_KEY=

# --- MySQL eksternal di server sekolah ---
# Isi DB_HOST / DB_USERNAME / DB_PASSWORD dengan nilai sebenar.
# Jangan guna sqlite untuk production.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=bbcashvia
DB_USERNAME=
DB_PASSWORD=

# Migrasi baseline tidak membuat jadual sessions/cache/jobs,
# jadi gunakan driver berasaskan fail/sync.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Tukar ke true SEKALI sahaja untuk jalankan migrate --force semasa deploy.
RUN_MIGRATIONS=false
