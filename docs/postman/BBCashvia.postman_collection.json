              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nis\": \"20240012\",\n  \"nama\": \"Ahmad Fauzi\",\n  \"id_kelas\": 3,\n  \"jenis_kelamin\": \"L\",\n  \"status\": \"Aktif\",\n  \"no_hp\": \"081234567890\"\n}",
